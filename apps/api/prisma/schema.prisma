datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =========================================================================
// ENUMS (Native PostgreSQL Types)
// =========================================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE

  @@map("user_status")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  PAUSED
  ARCHIVED
  COMPLETED

  @@map("project_status")
}

enum ProjectRole {
  LEAD
  CONTRIBUTOR
  VIEWER

  @@map("project_role")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
  CANCELLED

  @@map("task_status")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("task_priority")
}

enum OrgMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  INACTIVE

  @@map("org_member_status")
}

// =========================================================================
// 1. PROFILES (1:1 Mirror of Supabase auth.users)
// =========================================================================
model Profile {
  id          String     @id @db.Uuid // Explicitly matches auth.users.id
  email       String     @unique @db.VarChar(255)
  fullName    String     @map("full_name") @db.VarChar(150)
  displayName String?    @map("display_name") @db.VarChar(100)
  avatarUrl   String?    @map("avatar_url") @db.Text
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Reverse relationships
  createdOrganizations Organization[]       @relation("OrgCreator")
  organizationMembers  OrganizationMember[]
  createdProjects      Project[]            @relation("ProjectCreator")
  projectMembers       ProjectMember[]
  createdTasks         Task[]               @relation("TaskCreator")
  taskComments         TaskComment[]

  @@index([status], name: "idx_profiles_status")
  @@map("profiles")
}

// =========================================================================
// 2. ORGANIZATIONS (Top-Level Tenant Boundary)
// =========================================================================
model Organization {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(150)
  slug        String    @unique @db.VarChar(100)
  logoUrl     String?   @map("logo_url") @db.Text
  billingPlan String    @default("FREE") @map("billing_plan") @db.VarChar(50)
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  // Relationships
  createdBy Profile?             @relation("OrgCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   OrganizationMember[]
  roles     Role[]
  projects  Project[]

  @@index([deletedAt], name: "idx_orgs_deleted_at")
  @@map("organizations")
}

// =========================================================================
// 3. ROLES & PERMISSIONS (RBAC)
// =========================================================================
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid // NULL for system roles
  name           String   @db.VarChar(50)
  description    String?  @db.Text
  isSystemRole   Boolean  @default(false) @map("is_system_role")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relationships
  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  members      OrganizationMember[]

  @@unique([organizationId, name], name: "uq_role_org_name")
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  description String?  @db.Text
  module      String   @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// =========================================================================
// 4. ORGANIZATION MEMBERS (User-Org Mapping)
// =========================================================================
model OrganizationMember {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  roleId         String          @map("role_id") @db.Uuid
  status         OrgMemberStatus @default(INVITED)
  joinedAt       DateTime?       @map("joined_at") @db.Timestamptz
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)
  projectMembers ProjectMember[]

  // Composite unique constraint: ensures user belongs to org once & powers ProjectMember composite FK!
  @@unique([organizationId, userId], name: "uq_org_member")
  @@index([userId], name: "idx_org_members_user_id")
  @@index([organizationId, status], name: "idx_org_members_org_status")
  @@map("organization_members")
}

// =========================================================================
// 5. PROJECTS (Engineering Workspaces)
// =========================================================================
model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String        @db.VarChar(150)
  slug           String        @db.VarChar(100)
  description    String?       @db.Text
  status         ProjectStatus @default(PLANNING)
  createdById    String?       @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz

  // Relationships
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    Profile?        @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  tasks        Task[]

  // Composite unique constraints:
  // 1. Slugs are unique per organization
  // 2. [id, organizationId] enables composite FK references from ProjectMember & Task!
  @@unique([organizationId, slug], name: "uq_project_org_slug")
  @@unique([id, organizationId], name: "uq_project_id_org")
  @@index([organizationId, status], name: "idx_projects_org_status")
  @@map("projects")
}

// =========================================================================
// 6. PROJECT MEMBERS (Project ACL with Dual Multi-Tenant FKs)
// =========================================================================
model ProjectMember {
  id             String      @id @default(uuid()) @db.Uuid
  projectId      String      @map("project_id") @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  projectRole    ProjectRole @default(CONTRIBUTOR) @map("project_role")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz

  // Composite FK 1: Guarantees project belongs to the organization
  project Project @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)

  // Composite FK 2: Guarantees user is an active member of that exact organization!
  organizationMember OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  // Profile reverse relation
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Tasks assigned to this member (safely nulled on member removal)
  assignedTasks Task[]

  // A user can only be added to a project once
  @@unique([projectId, userId], name: "uq_project_user")
  @@index([userId, projectId], name: "idx_proj_members_user_proj")
  @@map("project_members")
}

// =========================================================================
// 7. TASKS (Work Items with Composite Project-Org Constraint)
// =========================================================================
model Task {
  id               String       @id @default(uuid()) @db.Uuid
  projectId        String       @map("project_id") @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  taskNumber       Int          @map("task_number")
  title            String       @db.VarChar(255)
  description      String?      @db.Text
  status           TaskStatus   @default(TODO)
  priority         TaskPriority @default(MEDIUM)
  assigneeMemberId String?      @map("assignee_member_id") @db.Uuid
  createdById      String?      @map("created_by_id") @db.Uuid
  estimatedHours   Decimal?     @map("estimated_hours") @db.Decimal(6, 2)
  dueDate          DateTime?    @map("due_date") @db.Date
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Composite FK: Guarantees task belongs to project AND organization simultaneously!
  project Project @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)

  createdBy Profile? @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Assignee FK: References ProjectMember.id.
  // When a member is removed from the project, assigneeMemberId is safely set to NULL
  // without breaking the required projectId or organizationId columns!
  assignee ProjectMember? @relation(fields: [assigneeMemberId], references: [id], onDelete: SetNull)

  comments TaskComment[]

  @@unique([projectId, taskNumber], name: "uq_task_project_number")
  @@index([projectId, status], name: "idx_tasks_project_status")
  @@index([assigneeMemberId], name: "idx_tasks_assignee_member")
  @@map("tasks")
}

// =========================================================================
// 8. TASK COMMENTS (Discussion Threads)
// =========================================================================
model TaskComment {
  id            String   @id @default(uuid()) @db.Uuid
  taskId        String   @map("task_id") @db.Uuid
  authorId      String?  @map("author_id") @db.Uuid
  content       String   @db.Text
  isAiGenerated Boolean  @default(false) @map("is_ai_generated")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  task   Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author Profile? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt], name: "idx_task_comments_task_created")
  @@map("task_comments")
}
